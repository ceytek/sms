# ============================================
# Toplu SMS Yonetim Platformu - Environment
# ============================================

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=sms_user
DATABASE_PASSWORD=sms_password
DATABASE_NAME=sms_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=24h

# Credential encryption (64 hex chars = 32 bytes for AES-256-GCM)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ============================================
# Ileride eklenecek
# ============================================

# SMS Provider
# mock = sahte adapter (varsayılan). live = kampanyanın SMS hesabındaki gerçek adapter
SMS_PROVIDER_MODE=mock
SMS_PROVIDER_TIMEOUT_MS=15000
SMS_WEBHOOK_TOKEN=
SMS_WEBHOOK_PUBLIC_URL=

# BullMQ
# BULLMQ_REDIS_HOST=localhost
# BULLMQ_REDIS_PORT=6379

# Monitoring
# SENTRY_DSN=
# PROMETHEUS_PORT=9090
